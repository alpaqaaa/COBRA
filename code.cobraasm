IMPORT math

NUM maxValue 10000

math.random 1 maxValue
NUM result @RET

STR Guess
NUM GuessNum
NUM guesses 1

GOTO True -MAINLOOP

-NOT_NUMBER
OUT "Error: Please enter a number"
GOTO True -MAINLOOP

-NOT_IN_RANGE
OUT "Error: Please enter a number between 0 and" maxValue "."
GOTO True -MAINLOOP

-SMALLER
OUT "The number you're looking for is smaller."
INC guesses
GOTO True -MAINLOOP

-LARGER
OUT "The number you're looking for is larger."
INC guesses
GOTO True -MAINLOOP

-MAINLOOP
IN Guess
GOTO !<IS_NUM>.Guess -NOT_NUMBER
SET GuessNum Guess
GOTO [GuessNum_LT_0] -NOT_IN_RANGE
GOTO [GuessNum_GT_maxValue] -NOT_IN_RANGE
GOTO [GuessNum_LT_result] -LARGER
GOTO [GuessNum_GT_result] -SMALLER

OUT "You guessed correctly!"
OUT "Guesses:" guesses